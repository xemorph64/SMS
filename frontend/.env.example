# Where the API lives.
#
# Leave unset for local development (the Vite proxy forwards /api to :8080) and
# for the packaged jar, where the API and this dashboard share an origin.
# Set it when the dashboard is deployed separately — e.g. on Vercel — and the
# Spring Boot service runs elsewhere:
#
#   VITE_API_BASE_URL=https://mailsentinel-abcdefgh-uc.a.run.app
#
# No trailing slash. This is a build-time variable: changing it means rebuilding.
VITE_API_BASE_URL=
